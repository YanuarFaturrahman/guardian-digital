# Contoh berkas .env.aiven (dipakai: php artisan migrate --env=aiven).
# Salin menjadi .env.aiven (sudah ada di .gitignore). JANGAN commit berisi kata sandi asli.
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # isi dari APP_KEY Vercel, atau php artisan key:generate --show
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx-nama.a.aivencloud.com
DB_PORT=00000
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=certs/aiven-ca.pem
SESSION_DRIVER=database
CACHE_STORE=database
