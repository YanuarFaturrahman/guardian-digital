# ============================================================
# Guardian Digital: contoh konfigurasi. SALIN jadi .env, JANGAN commit .env.
# Di Vercel, isi nilai-nilai ini lewat Settings > Environment Variables.
# ============================================================

APP_NAME="Guardian Digital"
APP_ENV=local               # production di server asli
APP_KEY=                    # php artisan key:generate
APP_DEBUG=true              # WAJIB false di production
APP_URL=http://localhost    # production: https://domain-anda (tanpa tanda kurung/markdown)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack           # di container/Vercel: stderr
LOG_LEVEL=debug

# ---------- Database ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guardian_digital
DB_USERNAME=root
DB_PASSWORD=
# Aiven wajib SSL. Path RELATIF ke folder project (berkas certs/aiven-ca.pem ikut di repo).
# MYSQL_ATTR_SSL_CA=certs/aiven-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false # production (HTTPS): true
CACHE_STORE=database        # penguncian login per akun memakai cache ini
QUEUE_CONNECTION=sync

# ---------- Email (SMTP sungguhan) ----------
# MAIL_MAILER=log hanya untuk pengembangan: email ditulis ke storage/logs dan TIDAK terkirim.
# Production wajib smtp. Contoh Brevo (gratis 300 email/hari): daftar di brevo.com,
# buat SMTP key, dan verifikasi alamat pengirim.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Keamanan akun ----------
EMAIL_VERIFICATION_REQUIRED=true   # aktif hanya jika MAIL_MAILER bukan log/array
TWO_FACTOR_REQUIRED=true           # 2FA wajib untuk superadmin dan admin sekolah
LOGIN_MAX_ATTEMPTS=5               # salah kata sandi sebelum akun dikunci
LOGIN_LOCKOUT_MINUTES=15
# FORCE_STRONG_PASSWORD_ON_LOGIN=true  # otomatis aktif di production

# ---------- Privasi ----------
PRIVACY_CONTROLLER_NAME="Nama Lembaga/Penyelenggara"
PRIVACY_CONTACT_EMAIL=privasi@domain-anda.com
PRIVACY_CONSENT_AGE=18             # di bawah usia ini, siswa butuh persetujuan orang tua/wali

# ---------- Superadmin pertama di production (dipakai AdminSeeder) ----------
# Beri nilai ini hanya saat menjalankan seeder, lalu hapus dari environment.
# ADMIN_NAME="Admin Guardian"
# ADMIN_EMAIL=
# ADMIN_PASSWORD=               # minimal 12 karakter, huruf besar+kecil+angka
